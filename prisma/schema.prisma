// =============================================================
//  SISTEMA HORTIFRÚTI — Schema Prisma
// =============================================================
//  Tabelas:
//   - users / roles / permissions / role_permissions
//   - password_reset_tokens (recuperação de senha via e-mail)
//   - fornecedores (suppliers)
//   - produtos (products) com peso padrão da caixa
//   - docas / conferentes / compradores (cadastros de recebimento)
//   - lancamentos (daily entries) + itens (entrada por produto)
//   - system_settings (configurações chave/valor)
//   - audit_logs (auditoria)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  PERFIS E PERMISSÕES
// ============================================================

enum RoleKind {
  ADMIN
  SUPERVISOR
  OPERADOR
}

// Situação de um lançamento:
//  PREVISTO   = pré-cadastro (previsão de chegada), ainda sem quantidades
//  CONFIRMADO = lançamento efetivado (mercadoria recebida/conferida)
enum LaunchStatus {
  PREVISTO
  CONFIRMADO
}

// Situação de cada item do lançamento:
//  PREVISTO = aguardando recebimento (fica na tela de Lançamentos)
//  RECEBIDO = conferido, com horário de entrada (vai para "Produtos recebidos")
enum LaunchItemStatus {
  PREVISTO
  RECEBIDO
}

model Role {
  id          String   @id @default(cuid())
  kind        RoleKind @unique
  name        String
  description String?
  system      Boolean  @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// Permissões granulares por módulo. Armazenamos como JSON para
// flexibilidade (visualizar, cadastrar, editar, excluir, exportar, etc).
model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String   // 'launches', 'products', 'suppliers', 'users', 'reports', 'settings', 'dashboard'
  actions   Json     // { view, create, edit, delete, export }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module])
  @@map("role_permissions")
}

// Módulos liberados individualmente para cada usuário.
// Lista vazia = herda todos os módulos permitidos pelo perfil.
model UserModulePermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  createdAt DateTime @default(now())

  @@unique([userId, module])
  @@map("user_module_permissions")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  email        String?   @unique
  passwordHash String
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  launches            Launch[]
  auditLogs           AuditLog[] @relation("AuditUser")
  modulePermissions   UserModulePermission[]
  passwordResetTokens PasswordResetToken[]

  @@index([username])
  @@index([active])
  @@map("users")
}

// Token de recuperação de senha: o valor original nunca é gravado,
// apenas o hash SHA-256, com validade curta e uso único.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
//  CADASTROS: FORNECEDORES E PRODUTOS
// ============================================================

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Campos complementares opcionais — não são necessários para cadastrar.
  document    String?
  legalName   String?
  contactName String?
  phone       String?
  email       String?
  city        String?
  state       String?
  notes       String?

  items       LaunchItem[]

  @@index([name])
  @@index([active])
  @@map("suppliers")
}

model Product {
  id              String   @id @default(cuid())
  name            String   @unique
  // Peso padrão da caixa em kg. Guardamos snapshot em cada item.
  defaultBoxKg    Decimal  @db.Decimal(10, 3)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Campos complementares opcionais — não são necessários para cadastrar.
  code            String?
  category        String?
  unit            String?
  notes           String?

  items           LaunchItem[]

  @@index([name])
  @@index([active])
  @@map("products")
}

// ============================================================
//  CADASTROS DE RECEBIMENTO
// ============================================================

model Dock {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  launches  Launch[]

  @@index([name])
  @@index([active])
  @@map("docks")
}

model Conferente {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  launches  Launch[]

  @@index([name])
  @@index([active])
  @@map("conferentes")
}

model Comprador {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  launches  Launch[]

  @@index([name])
  @@index([active])
  @@map("compradores")
}

// ============================================================
//  LANÇAMENTOS DIÁRIOS
// ============================================================
//  Um Launch agrupa todos os produtos lançados em uma data por um usuário.
//  Cada LaunchItem é um produto/fornecedor com suas quantidades.

model Launch {
  id          String       @id @default(cuid())
  referenceDate DateTime   @db.Date          // Data do lançamento (dia)
  status      LaunchStatus @default(CONFIRMADO)
  notes        String?

  // Docа, conferente e comprador do recebimento (snapshots preservam histórico).
  dockId        String?
  dock          Dock?        @relation(fields: [dockId], references: [id], onDelete: SetNull)
  dockName      String?
  conferenteId  String?
  conferente    Conferente?  @relation(fields: [conferenteId], references: [id], onDelete: SetNull)
  conferenteName String?
  compradorId   String?
  comprador     Comprador?   @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  compradorName String?

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        LaunchItem[]

  @@index([referenceDate])
  @@index([status])
  @@index([userId])
  @@index([dockId])
  @@index([conferenteId])
  @@index([compradorId])
  @@map("launches")
}

model LaunchItem {
  id           String   @id @default(cuid())
  launchId     String
  launch       Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  // Snapshot do nome do produto — preserva histórico.
  productName  String
  // Snapshot do nome do fornecedor.
  supplierName String
  // Snapshot do peso padrão da caixa no momento do lançamento.
  boxKg        Decimal  @db.Decimal(10, 3)

  // PREVISTO = aguardando recebimento / RECEBIDO = conferido com horário.
  status       LaunchItemStatus @default(PREVISTO)
  // Previsão informada pelo comprador.
  forecast     Decimal  @default(0) @db.Decimal(14, 3)
  // Quantidade que realmente chegou (informada pelo conferente).
  received     Decimal  @default(0) @db.Decimal(14, 3)
  // Rendimento informado à mão (base de pagamento ao fornecedor / estoque real).
  rendimento   Decimal  @default(0) @db.Decimal(14, 3)
  // Responsáveis POR ITEM — vários lançamentos podem acontecer ao mesmo tempo.
  compradorId    String?
  compradorName  String?
  conferenteId   String?
  conferenteName String?
  dockId         String?
  dockName       String?
  // Horário previsto pelo comprador (HH:mm) e horário em que o conferente lançou (HH:mm).
  forecastTime   String?
  // Horário de entrada de cada produto (HH:mm). Obrigatório ao receber.
  entryTime    String?
  // Observações do conferente sobre o produto recebido.
  notes        String?

  // Colunas legadas mantidas apenas para compatibilidade com o banco existente.
  // Não são usadas na UI, relatórios nem no fluxo novo.
  produced     Decimal  @default(0) @db.Decimal(14, 3)
  broken       Decimal  @default(0) @db.Decimal(14, 3)
  missing      Decimal  @default(0) @db.Decimal(14, 3)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([launchId])
  @@index([productId])
  @@index([supplierId])
  @@index([launchId, productId, supplierId])
  @@index([status])
  @@index([entryTime])
  @@index([forecastTime])
  @@index([compradorId])
  @@index([conferenteId])
  @@index([dockId])
  @@map("launch_items")
}

// ============================================================
//  CONFIGURAÇÕES E AUDITORIA
// ============================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  jsonValue Json?
  category  String   @default("GERAL")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("AuditUser", fields: [userId], references: [id])
  userName    String?  // snapshot (usuário pode ter sido removido)
  entity      String   // ex.: "launch", "product", "user"
  entityId    String?
  operation   String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | ...
  description String
  oldValues   Json?
  newValues   Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
