NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Banco Neon PostgreSQL (POOLED, com sslmode=require)
DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# JWT (gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Admin inicial (criado via seed.js)
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=TroqueEstaSenhaForte123!

LOG_LEVEL=info
