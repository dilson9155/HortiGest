NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Banco Neon PostgreSQL (POOLED, com sslmode=require)
DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# JWT (gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Admin inicial (criado via seed.js)
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=TroqueEstaSenhaForte123!

# URL pública da aplicação (usada para montar o link de recuperação de senha)
APP_URL=https://hortigest.elitesistemas.io
# Alternativa aceita: NEXT_PUBLIC_APP_URL=https://hortigest.elitesistemas.io

# Recuperação de senha via Resend (https://resend.com)
# Sem API key, o link é exibido no console do servidor (desenvolvimento).
RESEND_API_KEY=
# Remetente verificado no Resend
EMAIL_FROM=HortiGest <no-reply@seudominio.com.br>
# Apenas em desenvolvimento: exibe o link de teste na tela (nunca use em produção)
PASSWORD_RESET_DEV_LINK=false

LOG_LEVEL=info
